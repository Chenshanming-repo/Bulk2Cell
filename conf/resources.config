// Total scheduling budget for the local executor.
executor {
    cpus = 50
    memory = '208 GB'
    queueSize = 4
}
process {
    // Serial validation, file preparation and reference construction.
    withName: 'VALIDATE_SAMPLES|PREPARE_REFERENCE|BUILD_UNION' { cpus = 1 }

    // Starting allocations by workload; tune further using execution traces.
    withName: ISOSEQ_REFINE { cpus = 8 }
    withName: ISOSEQ_CLUSTER {
        cpus = 24
        memory = '192 GB'
    }
    withName: ISOSEQ_ALIGN {
        cpus = 24
        memory = '192 GB'
    }
    withName: 'ISOSEQ_COLLAPSE|PIGEON_FILTER' { cpus = 8 }
    withName: 'CELLRANGER_MKREF|CELLRANGER_COUNT' { cpus = 16 }
    withName: SALMON_INDEX { cpus = 16 }
    withName: SALMON_QUANT { cpus = 8 }

    // The Nextflow module caps quantify-full workers at eight.
    withName: BULK2CELL_QUANTIFY { cpus = 8 }
}
